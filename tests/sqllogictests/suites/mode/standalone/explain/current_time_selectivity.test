statement ok
CREATE OR REPLACE DATABASE current_time_selectivity

statement ok
USE current_time_selectivity

statement ok
CREATE TABLE fact_events AS
SELECT number % 1000 + 1 AS customer_id,
       add_seconds(to_timestamp('2024-01-01 00:00:00'), number) AS event_time
FROM numbers(10000)

statement ok
CREATE TABLE customers AS
SELECT number + 1 AS customer_id,
       number % 100 + 1 AS segment_id
FROM numbers(1000)

statement ok
CREATE TABLE segments AS
SELECT number + 1 AS segment_id
FROM numbers(100)

statement ok
CREATE TABLE orders AS
SELECT number % 1000 + 1 AS customer_id
FROM numbers(5000)

# CTAS records row counts and min/max statistics, so this case does not need ANALYZE TABLE.
# All events are historical, so the recent-time filter leaves fact_events the smallest input.
# `orders` is sized between the estimate this filter should produce (~2000 rows) and the
# 10000 rows a Unix-epoch cutoff would leave, so the build side pins the folded cutoff:
# with `now`, fact_events is the build side; with the epoch, `orders` would be.
query T
EXPLAIN optimized
SELECT count()
FROM fact_events AS e
JOIN orders AS o ON e.customer_id = o.customer_id
WHERE e.event_time >= subtract_hours(now(), 24)
----
Aggregate(Final)
├── group items: []
├── aggregate functions: [count() AS (#3)]
└── Aggregate(Partial)
    ├── group items: []
    ├── aggregate functions: [count() AS (#3)]
    └── Join(Inner)
        ├── build keys: [fact_events.customer_id (#0)]
        ├── probe keys: [orders.customer_id (#2)]
        ├── other filters: []
        ├── Scan
        │   ├── table: current_time_selectivity.fact_events (#0)
        │   ├── filters: [gte(fact_events.event_time (#1), subtract_hours(now(), 24))]
        │   ├── order by: []
        │   └── limit: NONE
        └── Scan
            ├── table: current_time_selectivity.orders (#1)
            ├── filters: []
            ├── order by: []
            └── limit: NONE

# The upstream case from PR #20298. The join order here does not depend on the folded
# cutoff (it is the same either way on this branch), so this only pins that a relative-time
# predicate survives optimization and stays pushed down to the scan.
query T
EXPLAIN optimized
SELECT count()
FROM fact_events AS e
JOIN customers AS c ON e.customer_id = c.customer_id
JOIN segments AS s ON c.segment_id = s.segment_id
WHERE e.event_time >= subtract_hours(now(), 24)
----
Aggregate(Final)
├── group items: []
├── aggregate functions: [count() AS (#5)]
└── Aggregate(Partial)
    ├── group items: []
    ├── aggregate functions: [count() AS (#5)]
    └── Join(Inner)
        ├── build keys: [customers.customer_id (#2)]
        ├── probe keys: [fact_events.customer_id (#0)]
        ├── other filters: []
        ├── Join(Inner)
        │   ├── build keys: [segments.segment_id (#4)]
        │   ├── probe keys: [customers.segment_id (#3)]
        │   ├── other filters: []
        │   ├── Scan
        │   │   ├── table: current_time_selectivity.segments (#2)
        │   │   ├── filters: []
        │   │   ├── order by: []
        │   │   └── limit: NONE
        │   └── Scan
        │       ├── table: current_time_selectivity.customers (#1)
        │       ├── filters: []
        │       ├── order by: []
        │       └── limit: NONE
        └── Scan
            ├── table: current_time_selectivity.fact_events (#0)
            ├── filters: [gte(fact_events.event_time (#1), subtract_hours(now(), 24))]
            ├── order by: []
