set inlist_runtime_filter_threshold = 1000;

statement ok
set min_max_runtime_filter_threshold = 1000;

statement ok
set bloom_runtime_filter_threshold = 1000;

statement ok
set join_runtime_filter_selectivity_threshold = 101;

# The probe key of the top join is a UnionAll output column. The runtime filter built from
# `b.uid` must reach the base-table scans of both union branches; the branch that needs a real
# type cast (`Int32` -> `Int64`) is not a target because bloom hashes are computed on the
# build-key type.
query T
EXPLAIN SELECT h.uid, h.fee
FROM rf_union_build b
JOIN (
    SELECT uid, tier, 'L' AS src, fee FROM rf_union_left
    UNION ALL
    SELECT uid, tier, 'R' AS src, fee FROM rf_union_right
    UNION ALL
    SELECT uid, tier, 'N' AS src, fee FROM rf_union_narrow
) h ON b.uid = h.uid AND b.tier = h.tier;
----
HashJoin
├── output columns: [uid (#18), fee (#21)]
├── join type: INNER
├── build keys: [b.uid (#0), b.tier (#1)]
├── probe keys: [h.uid (#18), h.tier (#19)]
├── keys is null equal: [false, false]
├── filters: []
├── build join filters:
│   ├── filter id:0, build key:b.uid (#0), probe targets:[uid (#2)@scan1, uid (#6)@scan2], filter type:bloom,inlist,min_max
│   └── filter id:1, build key:b.tier (#1), probe targets:[tier (#3)@scan1, tier (#7)@scan2, tier (#15)@scan3], filter type:bloom,inlist,min_max
├── estimated rows: 6.00
├── TableScan(Build)
│   ├── table: default.default.rf_union_build
