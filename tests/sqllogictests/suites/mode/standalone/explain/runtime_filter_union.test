# Results must not change: every branch still contributes its matching rows.
query IIT
SELECT h.uid, h.fee, h.src
FROM rf_union_build b
JOIN (
    SELECT uid, tier, 'L' AS src, fee FROM rf_union_left
    UNION ALL
    SELECT uid, tier, 'R' AS src, fee FROM rf_union_right
    UNION ALL
    SELECT uid, tier, 'N' AS src, fee FROM rf_union_narrow
) h ON b.uid = h.uid AND b.tier = h.tier
ORDER BY h.uid, h.fee;
----
1 10 L
1 100 R
1 1000 N

statement ok
set enable_join_runtime_filter = 0;

query IIT
SELECT h.uid, h.fee, h.src
FROM rf_union_build b
JOIN (
