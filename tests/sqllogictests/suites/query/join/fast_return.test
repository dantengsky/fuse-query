# Test for hash join fast return
statement ok
drop table if exists t1

statement ok
create table t1(a int, b int)

statement ok
insert into t1 values(7, 8), (3, 4), (5, 6)

statement ok
drop table if exists t2

statement ok
create table t2(a int, d int)

query IIII
select * from t1 inner join t2 on t1.a = t2.a order by t1.a, t2.a
----

query IIII
select * from t1 left join t2 on t1.a = t2.a order by t1.a, t2.a
----
3 4 NULL NULL
5 6 NULL NULL
7 8 NULL NULL

query IIII
select * from t2 left join t1 on t1.a = t2.a order by t1.a, t2.a
----

# The right/build side is preserved, so an empty build makes the result empty.
query IIII
select * from t1 right join t2 on t1.a = t2.a order by t1.a, t2.a
----

# The original fast-return cases belong in this shared standalone/cluster suite.
# Only the invalid probe-expression assertion added by 504adc0dfa was moved to
# mode/standalone/empty_right_join_short_circuit.test: that commit implemented
# local pipeline cancellation, not cross-fragment cancellation. A remote probe
# Exchange may evaluate its key before the receiving join sees the empty build.
# TODO: extend empty-build cancellation across distributed probe fragments and
# add cluster coverage if that stronger execution guarantee is implemented;
# do not treat the standalone test as proof that remote work is skipped.

statement ok
set force_join_data_spill = 1;

query IIII
select * from t1 inner join t2 on t1.a = t2.a order by t1.a, t2.a
----

query IIII
select * from t1 left join t2 on t1.a = t2.a order by t1.a, t2.a
----
3 4 NULL NULL
5 6 NULL NULL
7 8 NULL NULL

query IIII
select * from t2 left join t1 on t1.a = t2.a order by t1.a, t2.a
----

statement ok
unset force_join_data_spill;

statement ok
drop table if exists t1

statement ok
drop table if exists t2
