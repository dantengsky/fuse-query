## BINARY
statement ok
create or replace table t ( c binary);

statement ok
insert into t values ('hello'), ('world'), (null);

query T
select c::string from t order by c;
----
hello
world
NULL

statement ok
create or replace table t ( c binary not null);

statement ok
insert into t values ('test'), ('binary'), ('data');

query T
select c::string from t order by c;
----
binary
data
test

statement ok
create or replace table t ( c binary not null);

statement ok
insert into t values (''), ('a'), ('longer binary');

query I
select length(c) from t order by length(c);
----
0
1
13

## VARIANT
statement ok
create or replace table t ( c variant);

statement ok
insert into t values ('{"key": "value"}'), ('[1,2,3]'), (null);

query T
select * from t order by c;
----
{"key":"value"}
[1,2,3]
NULL

statement ok
create or replace table t ( c variant not null);

statement ok
insert into t values ('"string"'), ('123'), ('true');

query T
select * from t order by c;
----
true
123
"string"

## BITMAP
statement ok
create or replace table t ( c bitmap);

statement ok
insert into t values (build_bitmap([1,2,3])), (build_bitmap([4,5,6])), (null);

query I
select bitmap_count(c) from t order by bitmap_count(c);
----
3
3
NULL

statement ok
create or replace table t ( c bitmap not null);

statement ok
insert into t values (build_bitmap([])), (build_bitmap([1])), (build_bitmap([1,2,3,4,5]));

query I
select bitmap_count(c) from t order by bitmap_count(c);
----
0
1
5



## GEOMETRY

statement ok
set enable_geo_create_table=1

statement ok
create or replace table t ( c geometry);

statement ok
insert into t values (st_geomfromwkt('POINT(1 2)')), (st_geomfromwkt('POINT(3 4)')), (null);

query T
select st_astext(c) from t where c is not null order by st_astext(c);
----
POINT(1 2)
POINT(3 4)

statement ok
create or replace table t ( c geometry not null);

statement ok
insert into t values (st_geomfromwkt('POINT(0 0)')), (st_geomfromwkt('LINESTRING(0 0, 1 1)')), (st_geomfromwkt('POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'));

query I
select count(*) from t;
----
3

