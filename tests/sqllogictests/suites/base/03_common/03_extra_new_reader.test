# Test dictionary encoding with binary types
statement ok
set enable_fuse_parquet_dictionary_encoding = 1;

statement ok
create or replace table t_dict_binary ( c binary);

statement ok
insert into t_dict_binary values ('repeat'), ('repeat'), ('repeat'), ('unique'), (null);

query T
select distinct c::string from t_dict_binary order by c;
----
repeat
unique
NULL

statement ok
create or replace table t_dict_variant ( c variant);

statement ok
insert into t_dict_variant values ('{"same": "value"}'), ('{"same": "value"}'), ('{"different": "value"}'), (null);

query T
select distinct c from t_dict_variant order by c;
----
{"different":"value"}
{"same":"value"}
NULL

